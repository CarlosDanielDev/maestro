+import io
+import os
+import tempfile
 import unittest
+from unittest import mock
 
 import todo
 
 
 class TodoTest(unittest.TestCase):
     def setUp(self):
-        todo.TODOS.clear()
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.file = os.path.join(tmp.name, "todos.json")
+        patcher = mock.patch.dict(os.environ, {"TODO_FILE": self.file})
+        patcher.start()
+        self.addCleanup(patcher.stop)
+
+    def test_missing_file_is_empty(self):
+        self.assertEqual(todo.list_todos(), [])
 
     def test_add_and_list(self):
         todo.add("buy milk")
+        self.assertTrue(os.path.exists(self.file))
         self.assertEqual(todo.list_todos(), ["1. [ ] buy milk"])
 
+    def test_persists_across_calls(self):
+        todo.add("a")
+        self.assertEqual(todo.add("b"), 2)
+        self.assertEqual(todo.list_todos(), ["1. [ ] a", "2. [ ] b"])
+
+    def test_list_empty(self):
+        self.assertEqual(todo.list_todos(), [])
+
+    def test_list_several(self):
+        for t in ("a", "b", "c"):
+            todo.add(t)
+        self.assertEqual(
+            todo.list_todos(), ["1. [ ] a", "2. [ ] b", "3. [ ] c"]
+        )
+
+    def test_list_done_and_open(self):
+        todo.save([
+            {"text": "a", "done": True},
+            {"text": "b", "done": False},
+            {"text": "c", "done": True},
+        ])
+        self.assertEqual(
+            todo.list_todos(), ["1. [x] a", "2. [ ] b", "3. [x] c"]
+        )
+
+    def test_list_command_prints_lines(self):
+        todo.save([{"text": "a", "done": True}, {"text": "b", "done": False}])
+        with mock.patch("sys.stdout", new_callable=io.StringIO) as out:
+            self.assertEqual(todo.main(["list"]), 0)
+        self.assertEqual(out.getvalue(), "1. [x] a\n2. [ ] b\n")
+
+    def test_default_path(self):
+        with mock.patch.dict(os.environ):
+            os.environ.pop("TODO_FILE")
+            self.assertEqual(todo.path(), "todos.json")
+
 
 if __name__ == "__main__":
     unittest.main()
