{
  "alwaysThinkingEnabled": true,
  "behavior": {
    "caveman_mode": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": ".maestro/hooks/notify.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/carlos/projects/setwave/hooks/guards.py attribution"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/carlos/projects/setwave/hooks/guards.py forbidden-git"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/carlos/projects/setwave/hooks/guards.py secret-read"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/carlos/projects/setwave/hooks/guards.py dispatch-contract"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/carlos/projects/setwave/hooks/guards.py background-gate"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "context7": {
      "type": "url",
      "url": "https://mcp.context7.com/mcp"
    },
    "figma-remote-mcp": {
      "type": "url",
      "url": "https://mcp.figma.com/mcp"
    }
  }
}
